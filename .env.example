# web-app - env (copiar a .env.local, NUNCA commitear)
# Supabase: crear proyecto en https://supabase.com, luego Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=<https://tu-proyecto.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<tu-anon-key>
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=KuatiAuto <no-reply@kuatiauto.local>

# App URL (para redirects de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (opcional, E5)
SENTRY_DSN=

# Rate limit fail mode: open (dev) | closed (prod)
RATE_LIMIT_FAIL_MODE=open
